{
  "name": "sonar-ai-assistant",
  "version": "1.0.0",
  "description": "AI-powered visual assistance system",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "nodemon backend/server.js",
    "frontend": "python3 -m http.server 3000 --directory .",
    "build": "mkdir -p www && cp sonar.html www/sonar.html && cp login.html www/login.html && cp index.html www/index.html && npx cap sync",
    "cap:sync": "npx cap sync",
    "android": "npx cap open android",
    "ios": "npx cap open ios",
    "electron": "electron electron/main.js"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.10.0",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.24.6",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "nodemon": "^3.0.1"
  }
}
